{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SmartMotor BASIC",
  "scopeName": "source.smartmotor",
  "comment": "Generated by scripts/build-grammar.js from src/commands.json. Do not edit by hand.",
  "fileTypes": [
    "sms"
  ],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#directive"
    },
    {
      "include": "#statement"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.apostrophe.smartmotor",
      "match": "(').*$",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.smartmotor"
        }
      }
    },
    "directive": {
      "comment": "SMI preprocessor: #define NAME value, #ifdef NAME ... #endif",
      "patterns": [
        {
          "match": "^\\s*(#define)\\s+(\\S+)",
          "captures": {
            "1": {
              "name": "keyword.control.directive.smartmotor"
            },
            "2": {
              "name": "entity.name.constant.smartmotor"
            }
          }
        },
        {
          "match": "^\\s*(#(?:ifdef|ifndef|if|elif|else|endif|undef|include))\\b\\s*([A-Za-z_][A-Za-z0-9_]*)?",
          "captures": {
            "1": {
              "name": "keyword.control.directive.smartmotor"
            },
            "2": {
              "name": "entity.name.constant.smartmotor"
            }
          }
        }
      ]
    },
    "statement": {
      "patterns": [
        {
          "include": "#string"
        },
        {
          "include": "#label"
        },
        {
          "include": "#call"
        },
        {
          "include": "#control"
        },
        {
          "include": "#character"
        },
        {
          "include": "#flag"
        },
        {
          "include": "#reset"
        },
        {
          "include": "#command"
        },
        {
          "include": "#register"
        },
        {
          "include": "#function"
        },
        {
          "include": "#report"
        },
        {
          "include": "#array"
        },
        {
          "include": "#user-variable"
        },
        {
          "include": "#number"
        },
        {
          "include": "#address"
        },
        {
          "include": "#operator"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.smartmotor",
      "begin": "\"",
      "end": "\"|$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.smartmotor"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.smartmotor"
        }
      }
    },
    "label": {
      "comment": "Label C0, C1, ... C999 alone on its line (a comment may follow)",
      "match": "^\\s*(C\\d+)(?=\\s*(?:'|$))",
      "captures": {
        "1": {
          "name": "entity.name.function.label.smartmotor"
        }
      }
    },
    "call": {
      "comment": "GOSUB4, GOSUB(4), GOTO10, GOTO(10), GOSUB(x)",
      "patterns": [
        {
          "match": "\\b(GOSUB|GOTO)(?:(\\d+)\\b|\\s*(\\()\\s*(\\d+)\\s*(\\)))",
          "captures": {
            "1": {
              "name": "keyword.control.call.smartmotor"
            },
            "2": {
              "name": "entity.name.function.label.smartmotor"
            },
            "3": {
              "name": "punctuation.section.brackets.smartmotor"
            },
            "4": {
              "name": "entity.name.function.label.smartmotor"
            },
            "5": {
              "name": "punctuation.section.brackets.smartmotor"
            }
          }
        },
        {
          "match": "\\b(?:GOSUB|GOTO)\\b",
          "name": "keyword.control.call.smartmotor"
        }
      ]
    },
    "control": {
      "match": "\\b(?:DEFAULT|RETURNI|ELSEIF|RESUME|RETURN|SWITCH|BREAK|ENDIF|GOSUB|PAUSE|WHILE|CASE|ELSE|ENDS|GOTO|LOOP|RUN\\?|END|RUN|IF)(?![A-Za-z0-9_?])",
      "name": "keyword.control.smartmotor"
    },
    "character": {
      "comment": "Character code in PRINT: #13, or a variable holding it: #a",
      "match": "#(?:\\d+|([a-z])\\1{0,2})\\b",
      "name": "constant.character.smartmotor"
    },
    "report": {
      "comment": "Report commands: RPA, RKP, RBa, RW(0), Ra, Raa, Rab[3]",
      "match": "\\bR(?:GETCHR1|HM_MTHD|HM_OSET|FAUSTS|GETCHR|HM_ADT|HM_VTS|HM_VTZ|RANDOM|CADDR|CBAUD|EASAT|FSQRT|GROUP|IDENT|MCDIV|MCMUL|MFDIV|MFHTP|MFLTP|MFMUL|ACOS|ADDR|AMPS|ASIN|ATAN|ATOF|BAUD|EPTR|ERRC|ERRW|FABS|FSAD|LEN1|MODE|PMTN|PMTP|PTSD|PTST|SAMP|SQRT|TEMP|ABS|Bls|Bms|Bps|Brs|CAN|CHN|CLK|COS|CTR|CTT|DEA|DEL|DFS|ETH|HEX|INA|KII|KPI|LEN|LFS|PMA|PML|PMT|PRA|PRC|PRT|RES|SIN|SLM|SLN|SLP|SP2|SP6|SRM|SRR|TAN|TMR|TRQ|UIA|UJA|USB|AC|AT|Ba|Be|Bh|Bi|Bj|Bk|Bl|Bm|Bo|Bp|Br|Bs|Bt|Bv|Bw|Bx|CP|DT|EA|EL|FD|FW|IN|KA|KD|KG|KI|KL|KP|KS|KV|MH|OC|OF|PA|PC|PI|PT|SG|TH|TS|VA|VC|VL|VT|B|I|J|T|W|([a-z])\\1{0,2}|ab|af|al|aw)(?![A-Za-z0-9_])",
      "name": "support.function.report.smartmotor"
    },
    "flag": {
      "comment": "Status bits: Bo, Bt, Ba, Bls, Bi(0), B(word,bit)",
      "match": "\\b(?:Bls|Bms|Bps|Brs|Ba|Be|Bh|Bi|Bj|Bk|Bl|Bm|Bo|Bp|Br|Bs|Bt|Bv|Bw|Bx|B)\\b",
      "name": "constant.language.flag.smartmotor"
    },
    "reset": {
      "comment": "Flag resets: ZS, Za, Zrs, Z(word,bit)",
      "match": "\\b(?:Zls|Zrs|Za|Ze|Zh|Zl|Zr|Zs|ZS|Zv|Zw|Z)\\b",
      "name": "keyword.other.reset.smartmotor"
    },
    "command": {
      "match": "\\b(?:ECHO_OFF0|ECHO_OFF1|ECHO_OFF|SILENT1|BRKENG|BRKRLS|BRKSRV|BRKTRJ|CANCTL|COMCTL|ENCCTL|ETHCTL|MFSLEW|PRINT0|PRINT1|PRINT4|PRINT7|PRINT8|SCALEA|SCALEP|SCALEV|SILENT|SLEEP1|SYSCTL|TSWAIT|UPLOAD|ECHO0|ECHO1|EOIDX|IPCTL|LOCKP|MFCTP|MFSDC|PRINT|PRTSS|SADDR\\d*|SDORD|SDOWR|SLEEP|SNAME|STACK|TALK1|TWAIT|WAKE1|CCHN|DELM|DITR|ECHO|EIDE|EIGN|EILN|EILP|EIRE|EIRI|EISM|EITR|ENC0|ENC1|ENCD|EOBK|EOFT|ITRD|ITRE|LOAD|MDHV|MINV|OCHN|PRTS|PTSS|RCKS|RSP1|RSP5|RSRA|TALK|WAKE|Aij|Aji|CTA|CTE|CTW|ECS|FSA|ITR|MCE|MCW|MDB|MDC|MDE|MDH|MDS|MDT|MF0|MFA|MFD|MFH|MFL|MFR|MS0|MSR|MTB|NMT|OFF|PID\\d*|PTS|RSP|SLD|SLE|SRC|VAC|VLD|VST|Ai|Aj|GS|MC|MP|MT|MV|OR|OS|UP|UR|US|F|G|S|X|Z)\\b",
      "name": "keyword.other.command.smartmotor"
    },
    "register": {
      "match": "\\b(?:GETCHR1|HM_MTHD|HM_OSET|GETCHR|HM_ADT|HM_VTS|HM_VTZ|RANDOM|STDOUT|CADDR|CBAUD|EASAT|IDENT|MCDIV|MCMUL|MFDIV|MFHTP|MFLTP|MFMUL|ADDR|ADTS|AMPS|BAUD\\d*|EPTR|ERRC|ERRW|LEN1|MODE|PMTN|PMTP|PTSD|PTST|SAMP|WAIT|ADT|ATS|CLK|CTT|DEA|DEL|DTS|KII|KPI|LEN|OSH|PMA|PML|PMT|PRA|PRC|PRT|RES|SLN|SLP|SP2|SP6|SRM|SRR|TRQ|UIA|UJA|VTS|AC|AT|CP|DT|EA|EL|FD|FW|KA|KD|KG|KI|KL|KP|KS|KV|MH|PA|PI|PT|SG|TH|TS|VA|VC|VL|VT|O|T)\\b",
      "name": "variable.language.register.smartmotor"
    },
    "function": {
      "match": "\\b(?:FAUSTS|FSQRT|GROUP|ACOS|ASIN|ATAN|ATOF|FABS|FSAD|SQRT|TEMP|ABS|CAN|CHN|COS|CTR|DFS|ETH|HEX|INA|LFS|OUT|SIN|SLM|TAN|TMR|USB|IN|OC|OF|PC|UO|I|J|W)\\b",
      "name": "support.function.smartmotor"
    },
    "array": {
      "comment": "User arrays: ab[] (8 bit), aw[] (16 bit), al[] (32 bit), af[] (float)",
      "match": "\\b(?:ab|aw|al|af)(?=\\s*\\[)",
      "name": "variable.other.array.smartmotor"
    },
    "user-variable": {
      "comment": "User variables: a..z, aa..zz, aaa..zzz (the same letter repeated)",
      "match": "\\b([a-z])\\1{0,2}\\b",
      "name": "variable.other.user.smartmotor"
    },
    "number": {
      "match": "\\b\\d+(?:\\.\\d+)?\\b",
      "name": "constant.numeric.smartmotor"
    },
    "address": {
      "comment": "Combitronic motor address: G:0, EA:2, B(0,2):2",
      "match": ":(?=\\s*(?:\\d|[a-z]))",
      "name": "punctuation.separator.address.smartmotor"
    },
    "operator": {
      "patterns": [
        {
          "match": "==|!=|<=|>=|<|>",
          "name": "keyword.operator.comparison.smartmotor"
        },
        {
          "match": "&|\\||!|\\^",
          "name": "keyword.operator.logical.smartmotor"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.smartmotor"
        },
        {
          "match": "\\+|-|\\*|/|%",
          "name": "keyword.operator.arithmetic.smartmotor"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": ",",
          "name": "punctuation.separator.comma.smartmotor"
        },
        {
          "match": "[()\\[\\]]",
          "name": "punctuation.section.brackets.smartmotor"
        }
      ]
    }
  }
}
